<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/nokia_body">

    <!-- Top Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REX7 CALCULATOR"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#3D3833" />

        <Button
            android:id="@+id/btnSoundToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="SND: ON"
            android:textSize="10sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnThemeToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="THEME"
            android:textSize="10sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="HIST"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- LCD Display Section with 'R7' Side Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lcdScreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/retro_lcd_border"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="bottom|end">

            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/nokia_lcd_text"
                android:textSize="18sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:singleLine="true"
                android:textColor="@color/nokia_lcd_text"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Vertical 'R7' Retro Stamp -->
        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/retro_badge_border"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSideBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R\n7"
                android:lineSpacingExtra="2dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/nokia_badge" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Keypad Grid -->
    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins">

        <Button android:id="@+id/btnAC" android:text="AC" style="@style/RetroBtn" />
        <Button android:id="@+id/btnDel" android:text="DEL" style="@style/RetroBtn" />
        <Button android:id="@+id/btnPercent" android:text="%" style="@style/RetroBtn" />
        <Button android:id="@+id/btnDiv" android:text="÷" style="@style/RetroBtn" />

        <Button android:id="@+id/btn7" android:text="7" style="@style/RetroBtn" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/RetroBtn" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/RetroBtn" />
        <Button android:id="@+id/btnMul" android:text="×" style="@style/RetroBtn" />

        <Button android:id="@+id/btn4" android:text="4" style="@style/RetroBtn" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/RetroBtn" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/RetroBtn" />
        <Button android:id="@+id/btnSub" android:text="−" style="@style/RetroBtn" />

        <Button android:id="@+id/btn1" android:text="1" style="@style/RetroBtn" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/RetroBtn" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/RetroBtn" />
        <Button android:id="@+id/btnAdd" android:text="+" style="@style/RetroBtn" />

        <Button android:id="@+id/btnPlusMinus" android:text="±" style="@style/RetroBtn" />
        <Button android:id="@+id/btn0" android:text="0" style="@style/RetroBtn" />
        <Button android:id="@+id/btnDot" android:text="." style="@style/RetroBtn" />
        <Button android:id="@+id/btnEquals" android:text="=" style="@style/RetroBtn" />
    </GridLayout>

</LinearLayout>
