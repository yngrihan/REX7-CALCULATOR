<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18151E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Retro Calculator Body Chassis -->
    <LinearLayout
        android:id="@+id/chassisLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D8CBB5"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: History, Brand, Settings -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <TextView
                android:id="@+id/btnHistory"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:gravity="center"
                android:text="🕒"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:text="REX7"
                android:textColor="#26211C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#26211C"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- LCD Screen Frame -->
        <LinearLayout
            android:id="@+id/lcdBorderLayout"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="#2E2D28"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/lcdScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#8DA469"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvLcdFlag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="M"
                        android:textColor="#1B2313"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLcdClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="monospace"
                        android:text="12:34"
                        android:textColor="#1B2313"
                        android:textSize="13sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvExpression"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#1B2313"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end|bottom"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="#1B2313"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Speaker Grille Accent (Retro Detail) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.2"
            android:background="#000000" />

        <!-- 6 Rows x 4 Cols Evenly Distributed Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: AC, DEL, +/-, % -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btnAC" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="AC" android:textSize="17sp" android:textStyle="bold" />
                <Button android:id="@+id/btnDel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="DEL" android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/btnToggleSign" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="±" android:textSize="18sp" android:textStyle="bold" />
                <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="%" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: 7, 8, 9, ÷ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="7" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="8" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="9" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="÷" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 3: 4, 5, 6, × -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="4" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="5" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="6" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="×" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 4: 1, 2, 3, − -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="1" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="2" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="3" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="−" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 5: (, 0, ), + -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btnParenOpen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="(" android:textSize="18sp" android:textStyle="bold" />
                <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="0" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btnParenClose" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text=")" android:textSize="18sp" android:textStyle="bold" />
                <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="+" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 6: Wide Equals (span 3) and Dot -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:fontFamily="monospace" android:text="." android:textSize="22sp" android:textStyle="bold" />
                <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:layout_margin="3dp" android:fontFamily="monospace" android:text="=" android:textSize="26sp" android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
