<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#201E24"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/chassisLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D8CBB5"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:text="REX7"
                android:textColor="#26211C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHistory"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:gravity="center"
                android:text="🕒"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#26211C"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/lcdBorderLayout"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#3A3833"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/lcdScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#8FA76B"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvLcdFlag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="M"
                        android:textColor="#202A16"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLcdClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="monospace"
                        android:text="12:34"
                        android:textColor="#202A16"
                        android:textSize="14sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvExpression"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#202A16"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end|bottom"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="#202A16"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:stretchColumns="*">

            <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button android:id="@+id/btnAC" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="AC" android:textSize="17sp" android:textStyle="bold" />
                <Button android:id="@+id/btnDel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="DEL" android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/btnToggleSign" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="±" android:textSize="18sp" android:textStyle="bold" />
                <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="%" android:textSize="18sp" android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="7" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="8" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="9" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="÷" android:textSize="23sp" android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="4" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="5" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="6" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="×" android:textSize="23sp" android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="1" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="2" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="3" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="−" android:textSize="23sp" android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <Button android:id="@+id/btnParenOpen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="(" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="0" android:textSize="21sp" android:textStyle="bold" />
                <Button android:id="@+id/btnParenClose" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text=")" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="+" android:textSize="23sp" android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.95">
                <View android:layout_width="0dp" android:layout_height="match_parent" />
                <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:layout_span="2" android:fontFamily="monospace" android:text="=" android:textSize="26sp" android:textStyle="bold" />
                <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:fontFamily="monospace" android:text="." android:textSize="24sp" android:textStyle="bold" />
            </TableRow>
        </TableLayout>
    </LinearLayout>
</LinearLayout>
