<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Top Branding -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REX7"
            android:textColor="@color/brand_rex"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="CALCULATOR"
            android:textColor="@color/accent_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </RelativeLayout>

    <!-- Calculation Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="32sp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="64sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Full Modern Keypad -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6"
        android:stretchColumns="*">

        <!-- Row 1 -->
        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAC" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_func_bg"
                android:text="AC" android:textColor="#FF453A" android:textSize="22sp" android:textStyle="bold" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnParens" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_func_bg"
                android:text="( )" android:textColor="@color/text_primary" android:textSize="20sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_func_bg"
                android:text="%" android:textColor="@color/text_primary" android:textSize="22sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_op_bg"
                android:text="÷" android:textColor="@color/text_primary" android:textSize="28sp" />
        </TableRow>

        <!-- Row 2 -->
        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="7" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="8" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="9" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_op_bg"
                android:text="×" android:textColor="@color/text_primary" android:textSize="28sp" />
        </TableRow>

        <!-- Row 3 -->
        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="4" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="5" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="6" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_op_bg"
                android:text="−" android:textColor="@color/text_primary" android:textSize="28sp" />
        </TableRow>

        <!-- Row 4 -->
        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="1" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="2" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="3" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_op_bg"
                android:text="+" android:textColor="@color/text_primary" android:textSize="28sp" />
        </TableRow>

        <!-- Row 5 (± removed, Clean Backspace ⌫ added) -->
        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="0" android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="." android:textColor="@color/text_primary" android:textSize="24sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDel" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_num_bg"
                android:text="⌫" android:textColor="@color/text_primary" android:textSize="22sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_margin="5dp" android:background="@drawable/btn_op_bg"
                android:text="=" android:textColor="@color/text_primary" android:textSize="28sp" />
        </TableRow>
    </TableLayout>
</LinearLayout>
